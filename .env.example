# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe Payment Gateway Configuration
# STRIPE_SECRET_KEY: Secret key starting with sk_test_... or sk_live_... (used server-side)
STRIPE_SECRET_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY: Publishable key starting with pk_test_... or pk_live_... (client-side)
VITE_STRIPE_PUBLISHABLE_KEY=

# Option B: Real-Time Google Sheets Sync (Google Apps Script Webhook)
# 100% free Google Apps Script web app URL to auto-add delegate rows into your admissions Google Sheet
GOOGLE_SHEETS_WEBHOOK_URL=

# Automated Email Notifications (Resend API or Standard SMTP)
# RESEND_API_KEY: High-deliverability transactional email API key from resend.com (e.g. re_...)
RESEND_API_KEY=
# RESEND_FROM: Sender identity (defaults to 'WOW Academy Admissions <wowdigital@wowbusinessanddigital.com>', or 'onboarding@resend.dev' for sandbox tests)
RESEND_FROM=
# ADMISSIONS_EMAIL: Inbox to receive delegate submission notifications (defaults to wowdigital@wowbusinessanddigital.com)
ADMISSIONS_EMAIL=wowdigital@wowbusinessanddigital.com
ENQUIRIES_EMAIL=wowdigital@wowbusinessanddigital.com
ADMISSIONS_ADMIN_TOKEN=

# Alternative Standard SMTP Credentials (Optional if using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WOW Academy Admissions <wowdigital@wowbusinessanddigital.com>"

# Stripe hosted checkout: server-only settings. Never put these in VITE_ variables.
STRIPE_WEBHOOK_SECRET=""
# Generate a stable random secret (32+ bytes); preserve it so emailed payment links keep working.
PAYMENT_LINK_SECRET=""
# APP_URL must be the canonical HTTPS website origin.

# Set smtp to use IONOS even if old Resend settings remain. Default auto preserves existing behaviour.
MAIL_PROVIDER=auto
# IONOS UK: SMTP_HOST=smtp.ionos.co.uk; SMTP_PORT=465 (TLS) or 587 (STARTTLS).
# SMTP_USER is the full mailbox address; SMTP_PASS is its mailbox password.
